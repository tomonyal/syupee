rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザードキュメント：本人のみ読み書き可能 + 書き込み制限
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        // plan フィールドはクライアントから変更不可（Cloud Functionsのみ更新可能）
        && (!('plan' in request.resource.data) 
            || !('plan' in resource.data)
            || request.resource.data.plan == resource.data.plan)
        // 使用量カウンタは減少させられない（リセットはCloud Functions経由のみ）
        // resource.dataが存在しない場合（初回書き込み）は0として扱う
        && (!('ocrUsedThisMonth' in request.resource.data) 
            || request.resource.data.ocrUsedThisMonth >= (resource.data.get('ocrUsedThisMonth', 0)))
        && (!('chatUsedThisMonth' in request.resource.data)
            || request.resource.data.chatUsedThisMonth >= (resource.data.get('chatUsedThisMonth', 0)))
        // コイン残高はクライアントから増加不可（消費のみ許可、加算はCloud Functions経由）
        && (!('coinBalance' in request.resource.data)
            || !('coinBalance' in resource.data)
            || request.resource.data.coinBalance <= resource.data.coinBalance)
        // コイン残高は0以上を維持
        && (!('coinBalance' in request.resource.data)
            || request.resource.data.coinBalance >= 0)
        // 追加購入枠は0以上を維持
        && (!('ocrQuotaBalance' in request.resource.data)
            || request.resource.data.ocrQuotaBalance >= 0)
        && (!('chatQuotaBalance' in request.resource.data)
            || request.resource.data.chatQuotaBalance >= 0);
      
      // コイン取引履歴：消費記録のみクライアントから書き込み可（購入・ボーナスはCloud Functions経由）
      match /coinTransactions/{txId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.type == 'use'
          && request.resource.data.amount < 0;
        allow update, delete: if false;
      }
      
      // その他サブコレクション：読み取りのみ
      match /{subcollection=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // シーズンスキャン統計：本人のみ読み書き可能 + 全ユーザー参照可能
    match /seasonStats/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
    }

    // 不正利用アラート：Cloud Functions のみ書き込み（クライアントは読み書き不可）
    match /abuseAlerts/{alertId} {
      allow read, write: if false;
    }

    // その他のドキュメントはデフォルトで拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
