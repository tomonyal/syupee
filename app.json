{
  "expo": {
    "name": "シュッピくん",
    "slug": "syupee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B9D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syupee.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "レシートを撮影するためにカメラを使用します",
        "NSPhotoLibraryUsageDescription": "レシート画像を選択するために写真ライブラリにアクセスします"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B9D"
      },
      "package": "com.syupee.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-document-picker",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "@react-native-google-signin/google-signin",
      "react-native-purchases"
    ],
    "extra": {
      "eas": {
        "projectId": "7a0616e8-c650-481c-80a4-a52d60293276"
      }
    },
    "owner": "tomonary"
  }
}
